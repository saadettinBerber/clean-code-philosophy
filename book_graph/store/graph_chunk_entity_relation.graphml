<node id="Server Shutdown Policy">
  <data key="d0">Server Shutdown Policy</data>
  <data key="d1">concept</data>
  <data key="d2">Server Shutdown Policy is a responsibility of the server code concerning how the server stops processing.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-000</data>
