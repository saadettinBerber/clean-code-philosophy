<node id="Leap Year">
  <data key="d0">Leap Year</data>
  <data key="d1">concept</data>
  <data key="d2">Leap Year is a year, in the context of the SerialDate methods, determined by divisibility rules and considered when calculating leap-year counts and the length of February.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-016</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790599048</data>
  <data key="d6"></data>
</node>
