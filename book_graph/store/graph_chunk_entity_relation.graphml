<node id="Unprofessional Behavior">
  <data key="d0">Unprofessional Behavior</data>
  <data key="d1">concept</data>
  <data key="d2">Unprofessional Behavior is the conduct of satisfying oneself with merely working code rather than improving structure and design.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598420</data>
  <data key="d6"></data>
</node>
