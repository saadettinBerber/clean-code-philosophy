  <data key="d0">Session.initialize</data>
  <data key="d1">method</data>
  <data key="d2">Session.initialize is a method that initializes a session and can erase existing session data when called unexpectedly.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-006</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="checkPasswordAndInitializeSession">
  <data key="d0">checkPasswordAndInitializeSession</data>
  <data key="d1">method</data>
  <data key="d2">checkPasswordAndInitializeSession is a proposed renamed function for checkPassword that makes the session initialization side effect visible.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-006</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="appendFooter">
  <data key="d0">appendFooter</data>
  <data key="d1">method</data>
  <data key="d2">appendFooter is an example method whose argument report acts as an output argument, requiring a signature check to understand the intended data flow.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-006</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="setAndCheckIfExists">
  <data key="d0">setAndCheckIfExists</data>
  <data key="d1">method</data>
  <data key="d2">setAndCheckIfExists is a proposed renamed version of set intended to clarify that the function both sets and checks existence.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-006</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
