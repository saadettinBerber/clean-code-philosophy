<node id="Exceptions">
  <data key="d0">Exceptions</data>
  <data key="d1">concept</data>
  <data key="d2">Exceptions are a programming mechanism for transferring error handling from a call site to a catch handler.</data>
  <data key="d3">doc-98268aa1e2e5692cb0faaf2b6fae4a09-chunk-000</data>
  <data key="d4">chapter-07.txt</data>
  <data key="d5">1790604703</data>
