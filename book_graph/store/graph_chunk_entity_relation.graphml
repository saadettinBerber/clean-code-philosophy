<node id="Art of Programming">
  <data key="d0">Art of Programming</data>
  <data key="d1">concept</data>
  <data key="d2">The practice of programming, described as being and having always been the art of language design.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Art of Language Design">
  <data key="d0">Art of Language Design</data>
  <data key="d1">concept</data>
  <data key="d2">The practice of designing languages, identified as the true nature of programming and system description.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Function Rules">
  <data key="d0">Function Rules</data>
  <data key="d1">concept</data>
  <data key="d2">Rules for writing functions well that lead to short, well named, and nicely organized functions.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Hierarchy of Functions">
  <data key="d0">Hierarchy of Functions</data>
  <data key="d1">concept</data>
  <data key="d2">Hierarchical arrangement of functions that describe actions within a system and form part of a domain-specific language.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Master Programmers">
  <data key="d0">Master Programmers</data>
  <data key="d1">person</data>
  <data key="d2">Expert programmers who think of systems as stories and use programming language facilities to construct expressive domain-specific languages.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Small Functions">
  <data key="d0">Small Functions</data>
  <data key="d1">concept</data>
  <data key="d2">Functions kept small, where occasional multiple return, break, or continue statements can be harmless and expressive.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Large Functions">
  <data key="d0">Large Functions</data>
  <data key="d1">concept</data>
  <data key="d2">Functions large enough that structural rules can provide significant benefit and goto might make sense.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Recursion">
  <data key="d0">Recursion</data>
  <data key="d1">concept</data>
  <data key="d2">An artful act in which actions in a domain-specific language use the very language they define to tell their own part.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
