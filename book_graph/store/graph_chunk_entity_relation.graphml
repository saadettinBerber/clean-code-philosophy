  <data key="d6"></data>
</node>
<node id="BooleanArgs">
  <data key="d0">BooleanArgs</data>
  <data key="d1">artifact</data>
  <data key="d2">BooleanArgs is a private map in Args used to map character argument codes to boolean argument marshalers before replacement by the generic Map.</data>
