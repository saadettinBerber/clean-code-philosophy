<node id="Good Friday">
  <data key="d0">Good Friday</data>
  <data key="d1">event</data>
  <data key="d2">Good Friday is an example date mentioned in the documentation of RelativeDayOfWeekRule that can be specified as the Friday preceding Easter Sunday.</data>
