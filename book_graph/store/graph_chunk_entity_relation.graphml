  <data key="d5">1790606382</data>
  <data key="d6"></data>
</node>
<node id="Dependent Functions">
  <data key="d0">Dependent Functions</data>
  <data key="d1">concept</data>
  <data key="d2">Dependent Functions is the principle that a calling function should be placed vertically close to and above the functions it calls.</data>
  <data key="d3">doc-ae06dfc90c814559f684ae92cc598260-chunk-002</data>
  <data key="d4">chapter-05.txt</data>
