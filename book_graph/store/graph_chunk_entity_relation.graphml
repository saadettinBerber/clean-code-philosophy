  <data key="d6"></data>
</node>
<node id="Convenience">
  <data key="d0">Convenience</data>
  <data key="d1">concept</data>
  <data key="d2">Convenience is the benefit of having canned error messages already prepared.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
