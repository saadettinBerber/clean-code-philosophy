  <data key="d0">VT100</data>
  <data key="d1">artifact</data>
  <data key="d2">VT100 is a terminal whose 24-line by 80-column screen, with four lines used for administrative purposes, is cited in discussing the older screen-full rule for function size.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-001</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
