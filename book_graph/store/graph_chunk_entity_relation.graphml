<node id="Double Take">
  <data key="d0">Double Take</data>
  <data key="d1">concept</data>
  <data key="d2">Double Take is the moment of confusion caused by an argument that appears to be an input but may actually be an output.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-006</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
