  <data key="d6"></data>
</node>
<node id="Ward's Principle">
  <data key="d0">Ward's Principle</data>
  <data key="d1">concept</data>
  <data key="d2">Ward's Principle states that a routine is clean code when it turns out to be pretty much what the reader expected, and good naming helps achieve it.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-003</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
