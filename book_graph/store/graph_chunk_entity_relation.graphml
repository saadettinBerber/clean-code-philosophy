  <data key="d5">1790599080</data>
  <data key="d6"></data>
</node>
<node id="Function Implementation">
  <data key="d0">Function Implementation</data>
  <data key="d1">concept</data>
  <data key="d2">Function Implementation is the internal code of a function that, if required to understand the function's behavior, indicates a naming problem.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-005</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="Plain Text Report">
  <data key="d0">Plain Text Report</data>
  <data key="d1">content</data>
  <data key="d2">Plain Text Report is a report of hours worked by employees that HourlyReporter gathers and HourlyReportFormatter prints.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-005</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
