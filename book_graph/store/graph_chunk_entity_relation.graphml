<node id="Break Statement">
  <data key="d0">Break Statement</data>
  <data key="d1">concept</data>
  <data key="d2">Break Statement is a loop-control statement prohibited by the one entry one exit rule.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-007</data>
  <data key="d4">chapter-03.txt</data>
