  <data key="d4">chapter-07.txt</data>
  <data key="d5">1790604703</data>
  <data key="d6"></data>
</node>
<node id="MealExpensesNotFound">
  <data key="d0">MealExpensesNotFound</data>
  <data key="d1">artifact</data>
  <data key="d2">MealExpensesNotFound is an exception class caught in a billing example when meal expenses for an employee are not found, indicating that a meal per diem amount should be used instead.</data>
  <data key="d3">doc-98268aa1e2e5692cb0faaf2b6fae4a09-chunk-002</data>
  <data key="d4">chapter-07.txt</data>
  <data key="d5">1790604703</data>
  <data key="d6"></data>
