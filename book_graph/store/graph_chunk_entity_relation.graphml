</node>
<node id="YAML">
  <data key="d0">YAML</data>
  <data key="d1">concept</data>
  <data key="d2">YAML is a markup or data language that may appear as snippets in a Java source file.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="JavaDoc">
  <data key="d0">JavaDoc</data>
  <data key="d1">concept</data>
  <data key="d2">JavaDoc is a documentation markup language that may appear in Java source files and JSP files.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="English">
  <data key="d0">English</data>
  <data key="d1">concept</data>
  <data key="d2">English is a natural language that may appear as comments or text in a Java source file or JSP file.&lt;SEP&gt;English is the natural language used in the SerialDate comments and is listed as one of the languages mixed in the SerialDate source.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001&lt;SEP&gt;doc-f738bd6b0c75b6d085747dd812187c7e-chunk-001</data>
