<node id="Args.isStringSchemaElement">
  <data key="d0">Args.isStringSchemaElement</data>
  <data key="d1">method</data>
  <data key="d2">Args.isStringSchemaElement is a private method that returns true when a schema element tail equals the asterisk symbol.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-012</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598420</data>
  <data key="d6"></data>
