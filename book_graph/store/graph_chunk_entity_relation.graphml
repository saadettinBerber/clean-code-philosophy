</node>
<node id="NEAREST">
  <data key="d0">NEAREST</data>
  <data key="d1">data</data>
  <data key="d2">NEAREST is a public static final integer constant in SerialDate for specifying the nearest day of the week relative to a fixed date, with value 0.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-013</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790599006</data>
