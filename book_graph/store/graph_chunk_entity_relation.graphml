  <data key="d0">Special-Purpose Construction Module</data>
  <data key="d1">artifact</data>
  <data key="d2">A module in which dependent objects can be specified programmatically for Dependency Injection.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Setter Methods">
  <data key="d0">Setter Methods</data>
  <data key="d1">method</data>
  <data key="d2">Methods provided by a class for injecting dependencies during True Dependency Injection.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Constructor Arguments">
  <data key="d0">Constructor Arguments</data>
  <data key="d1">other</data>
  <data key="d2">Arguments provided to a class constructor that can be used to inject dependencies during True Dependency Injection.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="True Dependency Injection">
  <data key="d0">True Dependency Injection</data>
  <data key="d1">method</data>
  <data key="d2">A form of Dependency Injection in which a class is completely passive and dependencies are injected through setter methods or constructor arguments.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Proxy">
  <data key="d0">Proxy</data>
  <data key="d1">artifact</data>
  <data key="d2">Object-wrapping or interception technique used transparently by frameworks to extend or modify behavior.&lt;SEP&gt;An object constructed by some DI containers as a mechanism that can support Lazy-Evaluation.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001&lt;SEP&gt;doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Factory">
  <data key="d0">Factory</data>
  <data key="d1">method</data>
  <data key="d2">A construction mechanism that DI containers can invoke to support optimizations such as Lazy-Evaluation.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Physical Systems">
  <data key="d0">Physical Systems</data>
  <data key="d1">other</data>
  <data key="d2">Systems compared with Software Systems, which are unique because their architectures can grow incrementally.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Right The First Time Myth">
  <data key="d0">Right The First Time Myth</data>
  <data key="d1">concept</data>
  <data key="d2">A rejected belief that systems can be obtained right the first time, contrasted with Iterative and Incremental Agility.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Organic Growth">
  <data key="d0">Organic Growth</data>
  <data key="d1">concept</data>
  <data key="d2">System growth that is hindered when an architecture does not separate concerns appropriately, as in EJB1 and EJB2.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Local Interface">
  <data key="d0">Local Interface</data>
  <data key="d1">concept</data>
  <data key="d2">An in-process EJB interface that clients use, such as BankLocal.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Remote Interface">
  <data key="d0">Remote Interface</data>
  <data key="d1">concept</data>
  <data key="d2">An EJB interface that runs in a separate Java Virtual Machine and can be used by clients.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Table Row">
  <data key="d0">Table Row</data>
  <data key="d1">data</data>
  <data key="d2">A row of relational data represented in memory by an Entity Bean.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
