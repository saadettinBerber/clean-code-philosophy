<node id="SECOND_WEEK_IN_MONTH">
  <data key="d0">SECOND_WEEK_IN_MONTH</data>
  <data key="d1">data</data>
  <data key="d2">SECOND_WEEK_IN_MONTH is a public static final integer constant in SerialDate representing the second week in a month.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-013</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790599006</data>
