</node>
<node id="Bad Schedules">
  <data key="d0">Bad Schedules</data>
  <data key="d1">concept</data>
  <data key="d2">Bad Schedules are flawed project schedules that can be redone, in contrast to bad code.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598420</data>
