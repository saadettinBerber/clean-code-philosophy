<node id="Session">
  <data key="d0">Session</data>
  <data key="d1">artifact</data>
  <data key="d2">Session is a stateful object whose session data can be affected by Session.initialize.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-006</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
