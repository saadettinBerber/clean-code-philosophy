<node id="Protected Access">
  <data key="d0">Protected Access</data>
  <data key="d1">concept</data>
  <data key="d2">An access level applied to variables or utility functions so that tests can access them when privacy cannot be maintained.</data>
  <data key="d3">doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-000</data>
  <data key="d4">chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
</node>
<node id="Package Scope">
  <data key="d0">Package Scope</data>
  <data key="d1">concept</data>
  <data key="d2">An access level that permits tests in the same package to call functions or access variables when privacy is loosened as a last resort.</data>
  <data key="d3">doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-000</data>
  <data key="d4">chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
</node>
