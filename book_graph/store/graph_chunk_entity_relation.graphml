  <data key="d6"></data>
</node>
<node id="HashSet">
  <data key="d0">HashSet</data>
  <data key="d1">artifact</data>
  <data key="d2">HashSet is a Java set implementation used in the Args.java first draft for the argsFound field.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-002</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598385</data>
  <data key="d6"></data>
</node>
<node id="Science">
  <data key="d0">Science</data>
  <data key="d1">concept</data>
  <data key="d2">Science is the systematic approach mentioned as a contrast to the craft of programming.</data>
