  <data key="d0">renderForSuite</data>
  <data key="d1">method</data>
  <data key="d2">renderForSuite is a proposed split version of render that avoids a boolean flag and handles suite rendering explicitly.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-004</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
