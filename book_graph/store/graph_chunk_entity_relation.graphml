  <data key="d0">Client/Server Nonthreaded</data>
  <data key="d1">content</data>
  <data key="d2">Client/Server Nonthreaded is the full nonthreaded source example for the client/server application referenced starting on page 343.&lt;SEP&gt;Client/Server Nonthreaded is a tutorial subsection that groups nonthreaded client/server code examples.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-000&lt;SEP&gt;doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-010</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790598945</data>
