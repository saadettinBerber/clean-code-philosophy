  <data key="d0">Recompilation</data>
  <data key="d1">event</data>
  <data key="d2">Recompilation is the build activity that is forced on dependent classes when the Error enum changes.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-007</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
