<node id="Constant Placement">
  <data key="d0">Constant Placement</data>
  <data key="d1">concept</data>
  <data key="d2">Constant Placement is a code-organization principle stating that a well-known constant should be kept at the level where it is expected and passed down to the place that uses it.</data>
  <data key="d3">doc-ae06dfc90c814559f684ae92cc598260-chunk-003</data>
  <data key="d4">chapter-05.txt</data>
  <data key="d5">1790604436</data>
