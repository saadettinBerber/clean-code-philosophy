  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Programming Language">
  <data key="d0">Programming Language</data>
  <data key="d1">concept</data>
  <data key="d2">Chosen programming language providing facilities used to construct a richer domain-specific language.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Story">
  <data key="d0">Story</data>
  <data key="d1">concept</data>
  <data key="d2">Representation of a system as a story to be told, supported by a clear and precise domain-specific language.&lt;SEP&gt;A unit of work represented as today's stories or new stories implemented through Iterative and Incremental Agility.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008&lt;SEP&gt;doc-f8b0f36a5c42d0808fec00a058082be8-chunk-001</data>
  <data key="d4">chapter-03.txt&lt;SEP&gt;chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Classes">
  <data key="d0">Classes</data>
  <data key="d1">concept</data>
  <data key="d2">Nouns of the domain-specific language that can be broken out during code refinement.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
