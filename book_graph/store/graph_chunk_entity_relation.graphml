  <data key="d0">Pattern Names</data>
  <data key="d1">concept</data>
  <data key="d2">Pattern Names are design-pattern terminology recommended for Solution Domain Names.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-004</data>
  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603332</data>
