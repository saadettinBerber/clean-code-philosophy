<node id="Days Since Creation">
  <data key="d0">Days Since Creation</data>
  <data key="d1">data</data>
  <data key="d2">Days Since Creation is an intention-revealing variable name that specifies a duration measured in days since creation.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-000</data>
  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603331</data>
  <data key="d6"></data>
