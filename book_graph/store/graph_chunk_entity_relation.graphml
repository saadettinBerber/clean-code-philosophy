<edge source="Function" target="Artificial Coupling">
  <data key="d7">1.0</data>
  <data key="d8">Artificial coupling results from putting a function in a temporarily convenient but inappropriate location.</data>
  <data key="d9">misplaced declaration</data>
  <data key="d10">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-003</data>
  <data key="d11">chapter-17.txt</data>
