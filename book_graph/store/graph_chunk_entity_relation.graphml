<node id="Source Code">
  <data key="d0">Source Code</data>
  <data key="d1">concept</data>
  <data key="d2">Source Code is the software text from which duplication has been an ongoing target of elimination.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-007</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
