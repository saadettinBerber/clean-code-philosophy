  <data key="d5">1790603332</data>
  <data key="d6"></data>
</node>
<node id="Programmer-Eese">
  <data key="d0">Programmer-Eese</data>
  <data key="d1">concept</data>
  <data key="d2">Specialized programmer language that may be absent for a given coding activity.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-005</data>
  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603332</data>
  <data key="d6"></data>
</node>
<node id="Programmer">
  <data key="d0">Programmer</data>
  <data key="d1">person</data>
  <data key="d2">A person who maintains code and can ask a domain expert what a problem domain name means.&lt;SEP&gt;Programmer is a person who writes, reads, and maintains code, including adding comments, test cases, and TODO notes.&lt;SEP&gt;A person who writes code and comments, described as becoming better and happier when code is cleaned.&lt;SEP&gt;A human who writes programs and aims to improve programming skills, and who can be significantly impeded by bad code.&lt;SEP&gt;A programmer is a person who writes programs and makes a language appear simple.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-005&lt;SEP&gt;doc-ecee1e439eb5fb52d346911e1683e490-chunk-002&lt;SEP&gt;doc-ecee1e439eb5fb52d346911e1683e490-chunk-005&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-005</data>
  <data key="d4">chapter-02.txt&lt;SEP&gt;chapter-04.txt&lt;SEP&gt;chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Domain Expert">
  <data key="d0">Domain Expert</data>
  <data key="d1">person</data>
  <data key="d2">A person who can explain the meaning of a problem domain name to a programmer.&lt;SEP&gt;A person with domain knowledge whose language is used to evaluate the communication gap between domain concepts and code.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-005&lt;SEP&gt;doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-02.txt&lt;SEP&gt;chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Designer">
  <data key="d0">Designer</data>
  <data key="d1">person</data>
  <data key="d2">A person whose job includes separating solution concepts from problem domain concepts.&lt;SEP&gt;A designer is a person who makes a clean program look ridiculously simple like exceptional designs.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-005&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-005</data>
  <data key="d4">chapter-02.txt&lt;SEP&gt;chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Add Meaningful Context">
  <data key="d0">Add Meaningful Context</data>
  <data key="d1">method</data>
  <data key="d2">A naming technique that places names in context by enclosing names in well-named classes, functions, or namespaces, with prefixing as a last resort.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-005</data>
  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603332</data>
  <data key="d6"></data>
</node>
<node id="Don't Add Gratuitous Context">
  <data key="d0">Don't Add Gratuitous Context</data>
  <data key="d1">concept</data>
  <data key="d2">A naming principle that advises adding no more context to a name than is necessary and avoiding ubiquitous prefixes.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-005</data>
  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603332</data>
  <data key="d6"></data>
</node>
