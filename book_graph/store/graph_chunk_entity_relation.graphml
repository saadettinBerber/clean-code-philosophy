<node id="Client Processing">
  <data key="d0">Client Processing</data>
  <data key="d1">concept</data>
  <data key="d2">Client Processing is a responsibility of the server code to handle client messages and produce responses.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-000</data>
  <data key="d4">chapter-18.txt</data>
