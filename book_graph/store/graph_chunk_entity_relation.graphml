</node>
<node id="Virtual Machine">
  <data key="d0">Virtual Machine</data>
  <data key="d1">artifact</data>
  <data key="d2">Isolated execution environment used to run Windows XP for the course presentation.</data>
  <data key="d3">doc-178d6fd5b64909f0f5e42a12e3534440-chunk-004</data>
  <data key="d4">chapter-13.txt</data>
  <data key="d5">1790594063</data>
  <data key="d6"></data>
</node>
<node id="Threading Policies">
  <data key="d0">Threading Policies</data>
  <data key="d1">concept</data>
  <data key="d2">Operating-system-level scheduling and threading behaviors that affect multithreaded code execution.</data>
  <data key="d3">doc-178d6fd5b64909f0f5e42a12e3534440-chunk-004</data>
  <data key="d4">chapter-13.txt</data>
  <data key="d5">1790594063</data>
  <data key="d6"></data>
</node>
<node id="Deployment Environments">
  <data key="d0">Deployment Environments</data>
  <data key="d1">concept</data>
  <data key="d2">Potential target platforms or environments in which threaded code should be tested.</data>
  <data key="d3">doc-178d6fd5b64909f0f5e42a12e3534440-chunk-004</data>
  <data key="d4">chapter-13.txt</data>
  <data key="d5">1790594063</data>
  <data key="d6"></data>
</node>
<node id="Code Instrumentation">
  <data key="d0">Code Instrumentation</data>
  <data key="d1">method</data>
  <data key="d2">Technique of adding calls that change execution order to increase the chance of exposing rare concurrency flaws.&lt;SEP&gt;Code Instrumentation is the practice of adding calls or hooks to code, either manually or with automated technology, to support testing and observation of behavior.</data>
  <data key="d3">doc-178d6fd5b64909f0f5e42a12e3534440-chunk-004&lt;SEP&gt;doc-178d6fd5b64909f0f5e42a12e3534440-chunk-005</data>
  <data key="d4">chapter-13.txt</data>
  <data key="d5">1790594063</data>
  <data key="d6"></data>
</node>
