</node>
<node id="increaseByDays">
  <data key="d0">increaseByDays</data>
  <data key="d1">method</data>
  <data key="d2">increaseByDays is an alternative proposed method name for a Date operation that adds days to the date and changes the date instance.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-005</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
