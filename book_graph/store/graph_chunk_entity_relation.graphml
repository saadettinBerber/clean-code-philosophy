</node>
<node id="FOLLOWING">
  <data key="d0">FOLLOWING</data>
  <data key="d1">data</data>
  <data key="d2">FOLLOWING is a public static final integer constant in SerialDate for specifying a following day of the week relative to a fixed date, with value 1.</data>
