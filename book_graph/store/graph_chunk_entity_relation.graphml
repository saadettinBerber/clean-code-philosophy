<node id="Bad Team Dynamics">
  <data key="d0">Bad Team Dynamics</data>
  <data key="d1">concept</data>
  <data key="d2">Bad Team Dynamics are dysfunctional team interactions that can be repaired, in contrast to bad code.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598420</data>
