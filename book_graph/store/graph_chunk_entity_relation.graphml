</node>
<node id="Plant Manager">
  <data key="d0">Plant Manager</data>
  <data key="d1">person</data>
  <data key="d2">A manager who overrode each safety mechanism to run an experiment, contributing to the Chernobyl meltdown.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="Safety Mechanisms">
  <data key="d0">Safety Mechanisms</data>
  <data key="d1">artifact</data>
  <data key="d2">Protective mechanisms that can make running an experiment inconvenient but should not be overridden.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
