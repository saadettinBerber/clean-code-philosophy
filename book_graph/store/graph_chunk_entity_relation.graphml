<node id="Elapsed Time In Days">
  <data key="d0">Elapsed Time In Days</data>
  <data key="d1">data</data>
  <data key="d2">Elapsed Time In Days is the duration measurement intended by the variable name d, expressed in the unit of days.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-000</data>
  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603331</data>
