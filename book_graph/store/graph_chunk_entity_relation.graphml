  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Flag Arguments">
  <data key="d0">Flag Arguments</data>
  <data key="d1">concept</data>
  <data key="d2">Boolean arguments that loudly declare that a function does more than one thing, and are considered confusing and should be eliminated.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790601715</data>
