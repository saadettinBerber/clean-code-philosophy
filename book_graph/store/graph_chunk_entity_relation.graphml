<node id="Position Markers">
  <data key="d0">Position Markers</data>
  <data key="d1">concept</data>
  <data key="d2">Banner comments used to mark a particular position in a source file, generally considered clutter unless used sparingly.</data>
  <data key="d3">doc-ecee1e439eb5fb52d346911e1683e490-chunk-005</data>
  <data key="d4">chapter-04.txt</data>
