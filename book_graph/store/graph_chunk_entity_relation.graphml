  <data key="d0">Malignant Morass Of Code</data>
  <data key="d1">concept</data>
  <data key="d2">Malignant Morass Of Code is a harmful tangle of code created by teams in haste that can dominate team destiny.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598420</data>
  <data key="d6"></data>
</node>
<node id="Destiny">
  <data key="d0">Destiny</data>
  <data key="d1">concept</data>
  <data key="d2">Destiny is the future outcome of teams that can be dominated by a malignant morass of code.</data>
