  <data key="d1">data</data>
  <data key="d2">Custom Error Messages are user-created error messages written by users who do not like the error messages supplied by ArgsException.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598420</data>
  <data key="d6"></data>
</node>
<node id="Files">
  <data key="d0">Files</data>
  <data key="d1">artifact</data>
  <data key="d2">Files are the separate file locations into which all ArgumentMarshallers were moved.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598420</data>
  <data key="d6"></data>
</node>
<node id="Compromise">
  <data key="d0">Compromise</data>
  <data key="d1">concept</data>
  <data key="d2">Compromise is the accepted tradeoff of placing error message formatting code into ArgsException.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
  <data key="d4">chapter-14.txt</data>
