<node id="SATURDAY">
  <data key="d0">SATURDAY</data>
  <data key="d1">data</data>
  <data key="d2">SATURDAY is a public static final integer constant in SerialDate that is equivalent to java.util.Calendar.SATURDAY.&lt;SEP&gt;SATURDAY is a day-of-week constant used as the target day of week in getNearestDayOfWeek assertions.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-013&lt;SEP&gt;doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-031</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790599006</data>
  <data key="d6"></data>
</node>
<node id="SUNDAY">
  <data key="d0">SUNDAY</data>
  <data key="d1">data</data>
  <data key="d2">SUNDAY is a public static final integer constant in SerialDate that is equivalent to java.util.Calendar.SUNDAY.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-013</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790599006</data>
  <data key="d6"></data>
