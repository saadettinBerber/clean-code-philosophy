<node id="Attributions And Bylines">
  <data key="d0">Attributions And Bylines</data>
  <data key="d1">concept</data>
  <data key="d2">Comments recording who added source code, which can remain for years and become less accurate and relevant.</data>
  <data key="d3">doc-ecee1e439eb5fb52d346911e1683e490-chunk-005</data>
  <data key="d4">chapter-04.txt</data>
