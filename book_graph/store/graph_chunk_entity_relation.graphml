  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="N5: Use Long Names for Long Scopes">
  <data key="d0">N5: Use Long Names for Long Scopes</data>
  <data key="d1">concept</data>
  <data key="d2">A naming guideline directing name length to match scope length, using short names for tiny scopes and longer names for larger scopes.</data>
