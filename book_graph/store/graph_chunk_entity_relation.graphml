<node id="Special Case Pattern">
  <data key="d0">Special Case Pattern</data>
  <data key="d1">method</data>
  <data key="d2">Special Case Pattern is a design pattern in which a class or object encapsulates special-case behavior so client code avoids handling exceptional conditions.</data>
  <data key="d3">doc-98268aa1e2e5692cb0faaf2b6fae4a09-chunk-002</data>
  <data key="d4">chapter-07.txt</data>
  <data key="d5">1790604703</data>
  <data key="d6"></data>
</node>
<node id="Item">
  <data key="d0">Item</data>
  <data key="d1">artifact</data>
  <data key="d2">Item is a domain object with an identifier that can be registered with an existing item in an item registry example.</data>
  <data key="d3">doc-98268aa1e2e5692cb0faaf2b6fae4a09-chunk-002</data>
  <data key="d4">chapter-07.txt</data>
  <data key="d5">1790604703</data>
  <data key="d6"></data>
