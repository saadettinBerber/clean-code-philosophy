  <data key="d0">FRIDAY</data>
  <data key="d1">data</data>
  <data key="d2">FRIDAY is a public static final integer constant in SerialDate that is equivalent to Calendar.FRIDAY.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-013</data>
