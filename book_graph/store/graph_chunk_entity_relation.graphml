<edge source="Function" target="Vertical Separation">
  <data key="d7">1.0</data>
  <data key="d8">Vertical Separation requires functions to be defined close to where they are used.</data>
  <data key="d9">placement,proximity</data>
  <data key="d10">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-002</data>
