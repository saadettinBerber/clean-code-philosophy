  <data key="d0">PrimePrinter.java</data>
  <data key="d1">artifact</data>
  <data key="d2">PrimePrinter.java is a Java source file containing the refactored PrimePrinter class for printing prime numbers in a table.</data>
  <data key="d3">doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-003</data>
  <data key="d4">chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
</node>
<node id="RowColumnPagePrinter">
  <data key="d0">RowColumnPagePrinter</data>
  <data key="d1">artifact</data>
  <data key="d2">RowColumnPagePrinter is a Java class that formats and prints integer data in rows, columns, and pages with a configurable header.&lt;SEP&gt;RowColumnPagePrinter is a class that formats a list of numbers into pages with a specified number of rows and columns.</data>
  <data key="d3">doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-003&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-004</data>
  <data key="d4">chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
</node>
