  <data key="d0">ClassPathResource</data>
  <data key="d1">artifact</data>
  <data key="d2">Spring class used to locate the app.xml configuration file on the class path.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
