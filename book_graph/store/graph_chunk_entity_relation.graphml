  <data key="d6"></data>
</node>
<node id="Strategy Pattern">
  <data key="d0">Strategy Pattern</data>
  <data key="d1">concept</data>
  <data key="d2">A design pattern used to address subtle duplication in modules that have similar algorithms but do not share similar lines of code.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="Codd Normal Forms">
  <data key="d0">Codd Normal Forms</data>
  <data key="d1">concept</data>
  <data key="d2">Database normalization strategies for eliminating duplication in database schemae.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="Object Oriented">
  <data key="d0">Object Oriented</data>
  <data key="d1">concept</data>
  <data key="d2">An object-oriented strategy for organizing modules and eliminating duplication.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="Code at Wrong Level of Abstraction">
  <data key="d0">Code at Wrong Level of Abstraction</data>
  <data key="d1">concept</data>
  <data key="d2">Code at Wrong Level of Abstraction is a software design rule requiring higher level general concepts to be separated from lower level detailed concepts.&lt;SEP&gt;A code smell in which higher-level general concepts and lower-level detailed concepts are not completely separated in abstractions.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001&lt;SEP&gt;doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-002</data>
  <data key="d4">chapter-17.txt</data>
  <data key="d5">1790596259</data>
  <data key="d6"></data>
</node>
<node id="Boolean Arguments">
  <data key="d0">Boolean Arguments</data>
  <data key="d1">data</data>
  <data key="d2">Boolean Arguments are function arguments that loudly declare that a function does more than one thing and are confusing.&lt;SEP&gt;Boolean Arguments is a private Map from Character to Boolean field named booleanArgs in the Args class, initialized as a HashMap.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-001&lt;SEP&gt;doc-ff1f4d3804316cc277d01b65a1e72073-chunk-002</data>
  <data key="d4">chapter-17.txt&lt;SEP&gt;chapter-14.txt</data>
  <data key="d5">1790598385</data>
