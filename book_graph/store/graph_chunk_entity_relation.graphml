  <data key="d1">concept</data>
  <data key="d2">Systemic application infrastructure behaviors such as persistence, transactions, security, caching, and failover.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
