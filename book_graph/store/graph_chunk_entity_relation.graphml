</node>
<node id="Relative To String">
  <data key="d0">Relative To String</data>
  <data key="d1">method</data>
  <data key="d2">Relative To String is a static SerialDate method that converts a relative-position integer code into a descriptive string such as Preceding, Nearest, or Following.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-018</data>
  <data key="d4">chapter-18.txt</data>
