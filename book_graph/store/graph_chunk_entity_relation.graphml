<node id="Vertical Density">
  <data key="d0">Vertical Density</data>
  <data key="d1">concept</data>
  <data key="d2">Vertical Density is a code-formatting principle in which tightly related lines of code are placed close together vertically to express close association.</data>
  <data key="d3">doc-ae06dfc90c814559f684ae92cc598260-chunk-001</data>
  <data key="d4">chapter-05.txt</data>
  <data key="d5">1790604436</data>
  <data key="d6"></data>
</node>
<node id="Close Association">
  <data key="d0">Close Association</data>
  <data key="d1">concept</data>
  <data key="d2">Close Association is the idea that tightly related lines of code should be placed vertically dense so the related code appears as a single unit.</data>
  <data key="d3">doc-ae06dfc90c814559f684ae92cc598260-chunk-001</data>
  <data key="d4">chapter-05.txt</data>
  <data key="d5">1790604436</data>
  <data key="d6"></data>
</node>
<node id="Closely Related Concepts">
  <data key="d0">Closely Related Concepts</data>
  <data key="d1">concept</data>
  <data key="d2">Closely Related Concepts are code concepts that should be kept vertically close when those concepts belong in the same source file.</data>
  <data key="d3">doc-ae06dfc90c814559f684ae92cc598260-chunk-001</data>
  <data key="d4">chapter-05.txt</data>
  <data key="d5">1790604436</data>
