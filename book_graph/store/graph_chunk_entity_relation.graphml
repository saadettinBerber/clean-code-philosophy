  <data key="d2">Pragmatic Bookshelf is the publisher of the RSpec: Behavior Driven Development for Ruby Programmers book.</data>
  <data key="d3">doc-e6b59836a05af0c112c0d24b77e2c123-chunk-005</data>
  <data key="d4">chapter-09.txt</data>
  <data key="d5">1790606383</data>
