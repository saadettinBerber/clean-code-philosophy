<node id="Base Date">
  <data key="d0">Base Date</data>
  <data key="d1">concept</data>
  <data key="d2">Base Date is a reference date parameter used by SerialDate methods as the starting point for year addition or weekday search calculations.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-017</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790599048</data>
