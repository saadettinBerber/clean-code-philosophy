  <data key="d6"></data>
</node>
<node id="StockExchange">
  <data key="d0">StockExchange</data>
  <data key="d1">artifact</data>
  <data key="d2">StockExchange is an interface that declares the currentPrice method for retrieving the current price of a stock symbol.&lt;SEP&gt;StockExchange is a software interface representing the abstract operation of asking for the current price of a symbol.</data>
  <data key="d3">doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-005&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-006</data>
