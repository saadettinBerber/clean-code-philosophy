  <data key="d0">Listing 10-1</data>
  <data key="d1">content</data>
  <data key="d2">A code listing titled Too Many Responsibilities showing many method signatures, including setAllowDragging, allowDragging, isCustomizing, setTitle, getIdeMenuBar, and showHelper.&lt;SEP&gt;A code listing titled Too Many Responsibilities that outlines the SuperDashboard class and its many public methods.</data>
  <data key="d3">doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-000&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-001</data>
  <data key="d4">chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
