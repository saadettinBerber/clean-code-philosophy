  <data key="d0">RowColumnPagePrinter.java</data>
  <data key="d1">artifact</data>
  <data key="d2">RowColumnPagePrinter.java is a Java source file containing the RowColumnPagePrinter class.</data>
  <data key="d3">doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-003</data>
  <data key="d4">chapter-10.txt</data>
