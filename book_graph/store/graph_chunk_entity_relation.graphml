  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603332</data>
  <data key="d6"></data>
</node>
<node id="ProtocolController">
  <data key="d0">ProtocolController</data>
  <data key="d1">artifact</data>
  <data key="d2">ProtocolController is a class name example that uses the Controller term in the name.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-004</data>
  <data key="d4">chapter-02.txt</data>
