<edge source="Data Structure" target="Hybrid Structure">
  <data key="d7">1.0</data>
  <data key="d8">A Hybrid Structure is described as half Object and half Data Structure, giving it public variables or public accessors and mutators associated with a Data Structure.</data>
  <data key="d9">composition,hybrid design</data>
  <data key="d10">doc-cf9b0cb392cf6be9fae672222887f4bd-chunk-002</data>
  <data key="d11">chapter-06.txt</data>
  <data key="d12">1790604467</data>
  <data key="d13"></data>
</edge>
<edge source="Data Structure" target="Data Transfer Object">
  <data key="d7">1.0</data>
  <data key="d8">A Data Transfer Object is described as the quintessential form of a Data Structure.</data>
  <data key="d9">form,is a</data>
  <data key="d10">doc-cf9b0cb392cf6be9fae672222887f4bd-chunk-002</data>
  <data key="d11">chapter-06.txt</data>
  <data key="d12">1790604467</data>
  <data key="d13"></data>
</edge>
<edge source="Data Structure" target="Bean">
