<node id="Is Valid Weekday Code">
  <data key="d0">Is Valid Weekday Code</data>
  <data key="d1">method</data>
  <data key="d2">Is Valid Weekday Code is a static SerialDate validation method that determines whether a supplied day-of-week code is valid.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-018</data>
  <data key="d4">chapter-18.txt</data>
