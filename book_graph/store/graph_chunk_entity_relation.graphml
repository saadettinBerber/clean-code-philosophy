  <data key="d1">data</data>
  <data key="d2">Latest Date Ordinal is the constant representing the latest possible date supported by DayDate, with value 2958465 corresponding to 12/31/9999.</data>
  <data key="d3">doc-f738bd6b0c75b6d085747dd812187c7e-chunk-002</data>
  <data key="d4">chapter-16.txt</data>
