  <data key="d4">chapter-07.txt</data>
  <data key="d5">1790604703</data>
  <data key="d6"></data>
</node>
<node id="Robustness">
  <data key="d0">Robustness</data>
  <data key="d1">concept</data>
  <data key="d2">Robustness is a quality attribute of code that is described as a property of clean code and relates to handling failure conditions.</data>
  <data key="d3">doc-98268aa1e2e5692cb0faaf2b6fae4a09-chunk-003</data>
  <data key="d4">chapter-07.txt</data>
  <data key="d5">1790604703</data>
  <data key="d6"></data>
</node>
<node id="Main Logic">
  <data key="d0">Main Logic</data>
  <data key="d1">concept</data>
  <data key="d2">Main logic is the primary logic in code that can be reasoned about separately from error handling.</data>
  <data key="d3">doc-98268aa1e2e5692cb0faaf2b6fae4a09-chunk-003</data>
  <data key="d4">chapter-07.txt</data>
  <data key="d5">1790604703</data>
  <data key="d6"></data>
</node>
<node id="Chapter 8: Boundaries">
  <data key="d0">Chapter 8: Boundaries</data>
  <data key="d1">content</data>
  <data key="d2">A chapter that presents practices and techniques for keeping software boundaries clean when integrating foreign code into software systems.</data>
  <data key="d3">doc-207d517b4dd92803d5557692307191fb-chunk-000</data>
  <data key="d4">chapter-08.txt</data>
  <data key="d5">1790604868</data>
  <data key="d6"></data>
</node>
<node id="Software Boundaries">
  <data key="d0">Software Boundaries</data>
  <data key="d1">concept</data>
  <data key="d2">The integration points where third-party code, open source code, or internally produced components meet an application's own code.</data>
  <data key="d3">doc-207d517b4dd92803d5557692307191fb-chunk-000</data>
  <data key="d4">chapter-08.txt</data>
  <data key="d5">1790604868</data>
  <data key="d6"></data>
</node>
<node id="Third-Party Code">
  <data key="d0">Third-Party Code</data>
  <data key="d1">artifact</data>
  <data key="d2">External code introduced to add functionality to an application; understanding and integrating such code can require debugging and isolated experimentation.&lt;SEP&gt;Third-party packages, frameworks, or other externally supplied code that a system must integrate with its own code.</data>
  <data key="d3">doc-207d517b4dd92803d5557692307191fb-chunk-000&lt;SEP&gt;doc-207d517b4dd92803d5557692307191fb-chunk-001</data>
  <data key="d4">chapter-08.txt</data>
  <data key="d5">1790604868</data>
  <data key="d6"></data>
</node>
<node id="Open Source">
  <data key="d0">Open Source</data>
  <data key="d1">concept</data>
  <data key="d2">Open source software or code that a system may use as foreign code alongside its own code.</data>
  <data key="d3">doc-207d517b4dd92803d5557692307191fb-chunk-000</data>
  <data key="d4">chapter-08.txt</data>
  <data key="d5">1790604868</data>
  <data key="d6"></data>
</node>
<node id="Java.util.Map">
  <data key="d0">Java.util.Map</data>
  <data key="d1">artifact</data>
  <data key="d2">A Java collection interface that provides a broad set of methods for managing key-value data structures.</data>
  <data key="d3">doc-207d517b4dd92803d5557692307191fb-chunk-000</data>
  <data key="d4">chapter-08.txt</data>
  <data key="d5">1790604868</data>
  <data key="d6"></data>
</node>
