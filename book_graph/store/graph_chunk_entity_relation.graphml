<node id="loadPage">
  <data key="d0">loadPage</data>
  <data key="d1">method</data>
  <data key="d2">loadPage is a method that parses a resource, obtains a page through PageCrawler, and assigns page data when the page exists.</data>
  <data key="d3">doc-ae06dfc90c814559f684ae92cc598260-chunk-002</data>
  <data key="d4">chapter-05.txt</data>
  <data key="d5">1790604436</data>
  <data key="d6"></data>
