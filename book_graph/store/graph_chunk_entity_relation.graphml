  <data key="d0">Object.Wait</data>
  <data key="d1">method</data>
  <data key="d2">Java method called for code instrumentation to affect execution ordering.</data>
  <data key="d3">doc-178d6fd5b64909f0f5e42a12e3534440-chunk-004</data>
