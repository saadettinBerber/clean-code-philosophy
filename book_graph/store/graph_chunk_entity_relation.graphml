<node id="Argument">
  <data key="d0">Argument</data>
  <data key="d1">concept</data>
  <data key="d2">An argument is a named parameter in software that is one of the elements whose name should reveal the intent of the argument.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-000</data>
  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603331</data>
  <data key="d6"></data>
</node>
<node id="D">
  <data key="d0">D</data>
  <data key="d1">concept</data>
  <data key="d2">D is the short Java variable name d used in the initial example, where a comment identifies the value as elapsed time in days.</data>
  <data key="d3">doc-f209a7a16ee116e66dcaca0799c06baa-chunk-000</data>
  <data key="d4">chapter-02.txt</data>
  <data key="d5">1790603331</data>
