<node id="Threading Policy">
  <data key="d0">Threading Policy</data>
  <data key="d1">concept</data>
  <data key="d2">Threading Policy is a responsibility of the server code concerning how threads are created and managed.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-000</data>
