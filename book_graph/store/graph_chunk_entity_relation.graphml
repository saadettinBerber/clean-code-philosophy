  <data key="d0">Spring</data>
  <data key="d1">artifact</data>
  <data key="d2">Software framework that provides declarative configuration, dependency injection, and support for cross-cutting concerns in Java applications.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
