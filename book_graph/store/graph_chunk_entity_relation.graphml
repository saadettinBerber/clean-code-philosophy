<node id="Working Code">
  <data key="d0">Working Code</data>
  <data key="d1">concept</data>
  <data key="d2">Working Code is code that works, and Working Code can be badly broken.</data>
  <data key="d3">doc-ff1f4d3804316cc277d01b65a1e72073-chunk-021</data>
  <data key="d4">chapter-14.txt</data>
  <data key="d5">1790598420</data>
  <data key="d6"></data>
