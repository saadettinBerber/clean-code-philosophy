<node id="String Comparison Errors">
  <data key="d0">String Comparison Errors</data>
  <data key="d1">concept</data>
  <data key="d2">String Comparison Errors are differences between expected and actual string values that the ComparisonCompactor module is designed to identify and expose.</data>
  <data key="d3">doc-17d57202bcc8986bfbb2e844fedcd248-chunk-000</data>
  <data key="d4">chapter-15.txt</data>
  <data key="d5">1790594567</data>
  <data key="d6"></data>
</node>
<node id="JUnit Initial Development">
  <data key="d0">JUnit Initial Development</data>
  <data key="d1">event</data>
  <data key="d2">JUnit Initial Development is the occurrence when Kent Beck and Eric Gamma wrote the basics of JUnit during a flight to Atlanta.</data>
  <data key="d3">doc-17d57202bcc8986bfbb2e844fedcd248-chunk-000</data>
  <data key="d4">chapter-15.txt</data>
