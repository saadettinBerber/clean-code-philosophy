  <data key="d0">Listing 11-4</data>
  <data key="d1">content</data>
  <data key="d2">Code listing that shows a typical fragment of a Spring 2.X configuration file.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Listing 11-5">
  <data key="d0">Listing 11-5</data>
  <data key="d1">content</data>
  <data key="d2">Code listing that shows the Bank object rewritten as an EJB3 entity.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Figure 11-3">
  <data key="d0">Figure 11-3</data>
  <data key="d1">content</data>
  <data key="d2">Figure that illustrates the nested decorator structure described as the Russian doll of decorators around Bank.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Method Interception">
  <data key="d0">Method Interception</data>
  <data key="d1">method</data>
  <data key="d2">Method Interception is a technique used to implement AOP and mentioned as a source of possible confusion with AOP.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Wrapping">
  <data key="d0">Wrapping</data>
  <data key="d1">method</data>
  <data key="d2">Wrapping is a technique performed through proxies in the context of AOP.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Pure Java">
  <data key="d0">Pure Java</data>
  <data key="d1">concept</data>
  <data key="d2">Pure Java is the approach that does not use AspectJ.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Convention Over Configuration">
  <data key="d0">Convention Over Configuration</data>
  <data key="d1">concept</data>
  <data key="d2">Convention Over Configuration is a mechanism that can reduce explicit wiring logic in configuration examples.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="APIs">
  <data key="d0">APIs</data>
  <data key="d1">artifact</data>
  <data key="d2">APIs are alternative interfaces, used with declarative configuration files, to incorporate required application infrastructure.&lt;SEP&gt;Application programming interfaces in standard languages that can form Domain-Specific Languages.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004&lt;SEP&gt;doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Application Infrastructure">
  <data key="d0">Application Infrastructure</data>
  <data key="d1">concept</data>
  <data key="d2">Application Infrastructure is the required application support layer that includes cross-cutting concerns such as persistence, transactions, security, caching, and failover.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Declarative Configuration">
  <data key="d0">Declarative Configuration</data>
  <data key="d1">method</data>
  <data key="d2">Declarative Configuration is the use of declarative configuration files or APIs to specify Application Infrastructure and drive the DI Container.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="EJB Standard">
  <data key="d0">EJB Standard</data>
  <data key="d1">concept</data>
  <data key="d2">EJB Standard is the EJB standard that underwent a complete overhaul for version 3 due to compelling architecture examples such as Spring.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="GetAccounts">
  <data key="d0">GetAccounts</data>
  <data key="d1">method</data>
  <data key="d2">GetAccounts is a Bank method that Client invokes according to the described interaction.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="BANKS">
  <data key="d0">BANKS</data>
  <data key="d1">data</data>
  <data key="d2">BANKS is the database table name assigned to the Bank entity by the Table annotation.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Spring V2.5">
  <data key="d0">Spring V2.5</data>
  <data key="d1">artifact</data>
  <data key="d2">Spring V2.5 is the Spring version referenced for the app.xml configuration fragment.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="javax.persistence">
  <data key="d0">javax.persistence</data>
  <data key="d1">artifact</data>
  <data key="d2">javax.persistence is a Java package imported in the Bank EJB3 class.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Tight-Coupling">
  <data key="d0">Tight-Coupling</data>
  <data key="d1">concept</data>
  <data key="d2">Tight-Coupling is a problem associated with systems like EJB2 that is eliminated by the Spring-based application.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="EBJ3 Bank EJB">
  <data key="d0">EBJ3 Bank EJB</data>
  <data key="d1">artifact</data>
  <data key="d2">EBJ3 Bank EJB is an EJB code example shown in Listing 11-5, containing a setAccounts method and persistence annotations.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="EJB">
  <data key="d0">EJB</data>
  <data key="d1">artifact</data>
  <data key="d2">EJB is an early architecture or API for Java code, described as over-engineered, invasive, and compromising separation of concerns.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="AspectJ Annotation Form">
  <data key="d0">AspectJ Annotation Form</data>
  <data key="d1">method</data>
  <data key="d2">AspectJ Annotation Form is a technique in which Java 5 annotations define aspects using pure Java code, partially mitigating AspectJ adoption issues.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="XML Deployment Descriptors">
  <data key="d0">XML Deployment Descriptors</data>
  <data key="d1">artifact</data>
  <data key="d2">XML Deployment Descriptors are configuration files where persistence information from annotations can be moved, enabling a pure POJO approach.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Persistence Annotations">
  <data key="d0">Persistence Annotations</data>
  <data key="d1">other</data>
  <data key="d2">Persistence Annotations are annotations containing entity persistence mapping details in EJB code.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Modularized Domains Of Concern">
  <data key="d0">Modularized Domains Of Concern</data>
  <data key="d1">concept</data>
  <data key="d2">Modularized Domains Of Concern are modularized domains in an optimal system architecture, implemented with plain old objects and integrated with aspects or aspect-like tools.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Aspects">
  <data key="d0">Aspects</data>
  <data key="d1">concept</data>
  <data key="d2">Aspects are modularity constructs used to separate concerns across a system.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Aspect-Like Tools">
  <data key="d0">Aspect-Like Tools</data>
  <data key="d1">artifact</data>
  <data key="d2">Aspect-Like Tools are tools that provide aspect-like separation of concerns, including the pure Java approaches provided by Spring AOP and JBoss AOP.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Test-Driven Architecture">
  <data key="d0">Test-Driven Architecture</data>
  <data key="d1">method</data>
  <data key="d2">Test-Driven Architecture is an approach in which a software architecture can be evolved and verified by test driving it from simple to sophisticated.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Domain Logic">
  <data key="d0">Domain Logic</data>
  <data key="d1">concept</data>
  <data key="d2">Domain Logic is the application business logic that can be written using POJOs and decoupled from architecture concerns.&lt;SEP&gt;The domain-specific behavior of an application that can be overwhelmed by invasive architecture, obscured, and expressed through POJOs and Domain-Specific Languages.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005&lt;SEP&gt;doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Big Design Up Front">
  <data key="d0">Big Design Up Front</data>
  <data key="d1">method</data>
  <data key="d2">Big Design Up Front is the practice of designing everything up front before implementing anything, described as harmful because the practice inhibits adapting to change.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Up-Front Design">
  <data key="d0">Up-Front Design</data>
  <data key="d1">method</data>
  <data key="d2">Up-Front Design is a good practice of initial design that is distinct from Big Design Up Front.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Just-In-Time Decisions">
  <data key="d0">Just-In-Time Decisions</data>
  <data key="d1">concept</data>
  <data key="d2">Just-In-Time Decisions are decisions postponed until the last possible moment so that choices use the most recent knowledge.&lt;SEP&gt;Optimal decisions made using the most recent knowledge in an agile POJO-based context, with reduced decision complexity.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005&lt;SEP&gt;doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Decentralized Management And Decision Making">
  <data key="d0">Decentralized Management And Decision Making</data>
  <data key="d1">method</data>
  <data key="d2">Decentralized Management And Decision Making is distributed decision making enabled by modularity and separation of concerns in large systems.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Software Physics">
  <data key="d0">Software Physics</data>
  <data key="d1">concept</data>
  <data key="d2">Software Physics is a term describing the feasibility of making radical changes to software, first used by Kolence.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Kolence">
  <data key="d0">Kolence</data>
  <data key="d1">person</data>
  <data key="d2">Kolence is the individual credited in the input text with first using the term Software Physics.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Customer Feedback">
  <data key="d0">Customer Feedback</data>
  <data key="d1">data</data>
  <data key="d2">Customer Feedback is feedback from customers that supports informed decisions when decisions are postponed.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Architecture Concerns">
  <data key="d0">Architecture Concerns</data>
  <data key="d1">concept</data>
  <data key="d2">Architecture Concerns are architecture-level concerns from which domain logic can be decoupled when implemented with POJOs.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="SetAccounts">
  <data key="d0">SetAccounts</data>
  <data key="d1">method</data>
  <data key="d2">SetAccounts is a public method in EBJ3 Bank EJB that assigns a collection of Account to the accounts field.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Optimal System Architecture">
  <data key="d0">Optimal System Architecture</data>
  <data key="d1">concept</data>
  <data key="d2">Optimal System Architecture is a modularized architecture of domains of concern implemented with plain old objects and integrated with minimally invasive aspects or aspect-like tools.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Agility">
  <data key="d0">Agility</data>
  <data key="d1">concept</data>
  <data key="d2">Agility is the flexibility provided by a POJO system with modularized concerns that allows optimal just-in-time decisions and reduces decision complexity.&lt;SEP&gt;The capability attributed to a POJO system that enables optimal just-in-time decisions based on recent knowledge and underlies the benefits of Test-Driven Development.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005&lt;SEP&gt;doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Premature Decision">
  <data key="d0">Premature Decision</data>
  <data key="d1">concept</data>
  <data key="d2">Premature Decision is a decision made with suboptimal knowledge before customer feedback, reflection, and implementation experience are available.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Building Construction">
  <data key="d0">Building Construction</data>
  <data key="d1">other</data>
  <data key="d2">Building Construction is a mature industry in which architects use Big Design Up Front because radical changes to large physical structures are not feasible once construction is underway.&lt;SEP&gt;A mature industry and domain with highly optimized parts, methods, standards, and a rich language of vocabulary, idioms, and patterns.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-005&lt;SEP&gt;doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="POJO System">
  <data key="d0">POJO System</data>
  <data key="d1">concept</data>
  <data key="d2">A software system characterized by POJOs and modularized concerns that provides agility, reduces decision complexity, and supports noninvasive incorporation of implementation concerns.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Modularized Concerns">
  <data key="d0">Modularized Concerns</data>
  <data key="d1">concept</data>
  <data key="d2">Separated concerns within a POJO system that support agile decision-making and noninvasive architecture.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Standards">
  <data key="d0">Standards</data>
  <data key="d1">concept</data>
  <data key="d2">Established industry or software norms that help reuse ideas, recruit experienced people, encapsulate good ideas, and wire components together, though they may lag adopter needs.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="EJB2 Architecture">
  <data key="d0">EJB2 Architecture</data>
  <data key="d1">method</data>
  <data key="d2">A standard software architecture used by teams because of its standard status, even when lighterweight designs were sufficient.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Domain-Specific Languages">
  <data key="d0">Domain-Specific Languages</data>
  <data key="d1">concept</data>
  <data key="d2">Small scripting languages or APIs in standard languages that let code read like structured prose and allow application domains to be expressed as POJOs.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Code Idioms">
  <data key="d0">Code Idioms</data>
  <data key="d1">concept</data>
  <data key="d2">Code-level idioms below which Domain-Specific Languages raise the abstraction level.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Invasive Architecture">
  <data key="d0">Invasive Architecture</data>
  <data key="d1">concept</data>
  <data key="d2">An architecture that overwhelms domain logic, impacts agility, and can hide bugs and complicate story implementation.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Aspect-Like Mechanisms">
  <data key="d0">Aspect-Like Mechanisms</data>
  <data key="d1">method</data>
  <data key="d2">Noninvasive mechanisms used with POJOs to incorporate implementation concerns without obscuring intent or domain logic.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Simplest Thing That Can Possibly Work">
  <data key="d0">Simplest Thing That Can Possibly Work</data>
  <data key="d1">concept</data>
  <data key="d2">A design principle to apply when designing systems or individual modules.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="JMock">
  <data key="d0">JMock</data>
  <data key="d1">artifact</data>
  <data key="d2">A lightweight mock object library for Java and an example of a Java API that creates a Domain-Specific Language.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Christopher Alexander">
  <data key="d0">Christopher Alexander</data>
  <data key="d1">person</data>
  <data key="d2">A person whose work is described as particularly influential on the software community and who authored A Timeless Way of Building.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="A Timeless Way of Building">
  <data key="d0">A Timeless Way of Building</data>
  <data key="d1">content</data>
  <data key="d2">A 1979 book by Christopher Alexander, published by Oxford University Press in New York.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Oxford University Press">
  <data key="d0">Oxford University Press</data>
  <data key="d1">organization</data>
  <data key="d2">A publisher of A Timeless Way of Building.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="New York">
  <data key="d0">New York</data>
  <data key="d1">location</data>
  <data key="d2">A location associated with the publication of A Timeless Way of Building.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Recent Knowledge">
  <data key="d0">Recent Knowledge</data>
  <data key="d1">concept</data>
  <data key="d2">The most recent knowledge used as the basis for optimal just-in-time decisions.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Decision Complexity">
  <data key="d0">Decision Complexity</data>
  <data key="d1">concept</data>
  <data key="d2">The complexity associated with making decisions, which is reduced by the agility provided by a POJO system.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Lighterweight Designs">
  <data key="d0">Lighterweight Designs</data>
  <data key="d1">concept</data>
  <data key="d2">Lighterweight and more straightforward software designs that were sufficient in situations where teams used EJB2.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Customer Value">
  <data key="d0">Customer Value</data>
  <data key="d1">concept</data>
  <data key="d2">Value implemented for customers, which can be deprioritized when teams become obsessed with strongly hyped standards.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Reuse">
  <data key="d0">Reuse</data>
  <data key="d1">concept</data>
  <data key="d2">The reuse of ideas and components that standards make easier.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Components">
  <data key="d0">Components</data>
  <data key="d1">artifact</data>
  <data key="d2">Reusable software components that standards help encapsulate and wire together.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Rich Language">
  <data key="d0">Rich Language</data>
  <data key="d1">concept</data>
  <data key="d2">A domain language developed in building construction that conveys essential information clearly and concisely.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Vocabulary">
  <data key="d0">Vocabulary</data>
  <data key="d1">concept</data>
  <data key="d2">The set of words included in the rich language of building construction.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Idioms">
  <data key="d0">Idioms</data>
  <data key="d1">concept</data>
  <data key="d2">The customary expressions included in the rich language of building construction.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Patterns">
  <data key="d0">Patterns</data>
  <data key="d1">concept</data>
  <data key="d2">The recurring forms included in the rich language of building construction.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Scripting Languages">
  <data key="d0">Scripting Languages</data>
  <data key="d1">concept</data>
  <data key="d2">Small, separate scripting languages that can form Domain-Specific Languages.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Standard Languages">
  <data key="d0">Standard Languages</data>
  <data key="d1">artifact</data>
  <data key="d2">Programming languages in which Domain-Specific Languages are implemented as scripting languages or APIs.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Structured Prose">
  <data key="d0">Structured Prose</data>
  <data key="d1">concept</data>
  <data key="d2">A structured form of prose that code can resemble and that a domain expert might write.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Communication Gap">
  <data key="d0">Communication Gap</data>
  <data key="d1">concept</data>
  <data key="d2">The gap between a domain concept and the code that implements it, which a good Domain-Specific Language minimizes.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Domain Concept">
  <data key="d0">Domain Concept</data>
  <data key="d1">concept</data>
  <data key="d2">A concept in a domain whose implementation in code can be separated by a communication gap.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Agile Practices">
  <data key="d0">Agile Practices</data>
  <data key="d1">method</data>
  <data key="d2">Practices that optimize communications within a team and with project stakeholders.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Communications">
  <data key="d0">Communications</data>
  <data key="d1">concept</data>
  <data key="d2">The exchange of information within a team and with project stakeholders that agile practices optimize.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Stakeholders">
  <data key="d0">Stakeholders</data>
  <data key="d1">person</data>
  <data key="d2">Project stakeholders with whom communications are optimized by agile practices.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Abstraction Level">
  <data key="d0">Abstraction Level</data>
  <data key="d1">concept</data>
  <data key="d2">The level of abstraction raised by effectively used Domain-Specific Languages above code idioms and design patterns.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Quality">
  <data key="d0">Quality</data>
  <data key="d1">concept</data>
  <data key="d2">The overall quality of a system that suffers when domain logic is obscured.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Bugs">
  <data key="d0">Bugs</data>
  <data key="d1">concept</data>
  <data key="d2">Defects that find it easier to hide when domain logic is obscured.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Productivity">
  <data key="d0">Productivity</data>
  <data key="d1">concept</data>
  <data key="d2">The output efficiency that suffers when agility is compromised.&lt;SEP&gt;The effective output rate of a development team; the rate decreases as mess builds and can approach zero under pressure and poor design understanding.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-11.txt&lt;SEP&gt;chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Implementation Concerns">
  <data key="d0">Implementation Concerns</data>
  <data key="d1">concept</data>
  <data key="d2">Non-domain implementation concerns incorporated noninvasively by aspect-like mechanisms.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Systems">
  <data key="d0">Systems</data>
  <data key="d1">artifact</data>
  <data key="d2">Software systems for which the simplest thing that can possibly work should be used.&lt;SEP&gt;Successful software or operational systems that humans attempt to create from vague customer feelings.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-11.txt&lt;SEP&gt;chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="XUnit Patterns">
  <data key="d0">XUnit Patterns</data>
  <data key="d1">content</data>
  <data key="d2">A 2007 book by Gerard Mezzaros published by Addison-Wesley.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Gerard Mezzaros">
  <data key="d0">Gerard Mezzaros</data>
  <data key="d1">person</data>
  <data key="d2">The author of XUnit Patterns.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Eclipse AspectJ">
  <data key="d0">Eclipse AspectJ</data>
  <data key="d1">content</data>
  <data key="d2">A 2005 book about AspectJ by Adrian Colyer, Andy Clement, George Hurley, and Mathew Webster.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-006</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="Good Programming">
  <data key="d0">Good Programming</data>
  <data key="d1">concept</data>
  <data key="d2">Good programming is the subject of the Clean Code chapter and is associated with writing good code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Good Code">
  <data key="d0">Good Code</data>
  <data key="d1">concept</data>
  <data key="d2">Good code is the quality of code that the Clean Code chapter seeks to produce and distinguish from bad code.&lt;SEP&gt;Code presented as good in the book.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-006</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Requirements Specification">
  <data key="d0">Requirements Specification</data>
  <data key="d1">concept</data>
  <data key="d2">Requirements specification is the discipline of describing requirements formally and precisely, and the Clean Code chapter says well-specified requirements can act as executable tests of code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Specification">
  <data key="d0">Specification</data>
  <data key="d1">concept</data>
  <data key="d2">A detailed statement of requirements, including specifications in higher-level and domain-specific languages, that can be code when formal enough for machine execution.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Executable Test">
  <data key="d0">Executable Test</data>
  <data key="d1">method</data>
  <data key="d2">A test that can be executed to verify code, where well-specified requirements can act as executable tests of code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Business People">
  <data key="d0">Business People</data>
  <data key="d1">person</data>
  <data key="d2">Non-programmers who are imagined to generate programs from specifications, representing a speculative end-of-code scenario.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Killer App">
  <data key="d0">Killer App</data>
  <data key="d1">artifact</data>
  <data key="d2">A popular software product written in the late 1980s that became undermined by bugs, crashes, stretched release cycles, and bad code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Crash">
  <data key="d0">Crash</data>
  <data key="d1">event</data>
  <data key="d2">A failure of the killer app that increased over time and contributed to user frustration and product decline.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Release Cycle">
  <data key="d0">Release Cycle</data>
  <data key="d1">event</data>
  <data key="d2">The periodic releases of the killer app whose cycles began to stretch while bugs were not repaired.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Mathematicians">
  <data key="d0">Mathematicians</data>
  <data key="d1">person</data>
  <data key="d2">People who, analogously to code deniers, hope to discover a mathematics that does not have to be formal.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Mathematics">
  <data key="d0">Mathematics</data>
  <data key="d1">concept</data>
  <data key="d2">A formal discipline that mathematicians hope to discover in a non-formal form, used as an analogy for the inevitability of code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Humans">
  <data key="d0">Humans</data>
  <data key="d1">person</data>
  <data key="d2">People with intuition and creativity who have not been able to create successful systems from the vague feelings of customers.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Customers">
  <data key="d0">Customers</data>
  <data key="d1">organization</data>
  <data key="d2">People whose vague feelings or needs are difficult for humans to translate into successful systems.&lt;SEP&gt;A group of users who become frustrated with the team's production code outcomes.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000&lt;SEP&gt;doc-e6b59836a05af0c112c0d24b77e2c123-chunk-001</data>
  <data key="d4">chapter-01.txt&lt;SEP&gt;chapter-09.txt</data>
  <data key="d5">1790606382</data>
  <data key="d6"></data>
</node>
<node id="Vague Need">
  <data key="d0">Vague Need</data>
  <data key="d1">concept</data>
  <data key="d2">An imprecisely stated requirement or feeling that machines are imagined to translate into perfectly executing programs.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Professionals">
  <data key="d0">Professionals</data>
  <data key="d1">person</data>
  <data key="d2">People who bought and used the killer app, indicating the product's popularity.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Early Employee">
  <data key="d0">Early Employee</data>
  <data key="d1">person</data>
  <data key="d2">An early employee of the company who confirmed that the company rushed the product and made a mess in the code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-000</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Code Mess">
  <data key="d0">Code Mess</data>
  <data key="d1">concept</data>
  <data key="d2">A tangled, poorly designed condition of code where changes break other parts, cleanup becomes impossible, and productivity declines.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="LeBlanc's Law">
  <data key="d0">LeBlanc's Law</data>
  <data key="d1">concept</data>
  <data key="d2">A principle stated as later equals never, indicating that delayed cleanup of a mess often never occurs.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Management">
  <data key="d0">Management</data>
  <data key="d1">organization</data>
  <data key="d2">The project management group responsible for responding to declining productivity by adding staff, authorizing redesigns, and deciding when systems can be replaced.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Tiger Team">
  <data key="d0">Tiger Team</data>
  <data key="d1">organization</data>
  <data key="d2">A newly selected green-field team chosen from the best and brightest to build a replacement system during a grand redesign.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Old System">
  <data key="d0">Old System</data>
  <data key="d1">artifact</data>
  <data key="d2">The existing software system maintained by the team, receiving continuous changes, and required to be fully replicated by the new system before replacement.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="New System">
  <data key="d0">New System</data>
  <data key="d1">artifact</data>
  <data key="d2">The replacement software system built by the tiger team to perform everything the old system does while keeping pace with ongoing changes.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Grand Redesign in the Sky">
  <data key="d0">Grand Redesign in the Sky</data>
  <data key="d1">event</data>
  <data key="d2">The full-scale redesign demanded by the team and authorized by management; the redesign involves a tiger team starting a green-field project.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Figure 1-1">
  <data key="d0">Figure 1-1</data>
  <data key="d1">content</data>
  <data key="d2">A figure titled Productivity vs. time, accompanying the discussion of productivity decline as mess accumulates.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Dilbert Cartoon">
  <data key="d0">Dilbert Cartoon</data>
  <data key="d1">content</data>
  <data key="d2">A cartoon showing a programmer explaining schedule focus to a manager, with the manager asking what the programmer is doing to defend the code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Managers">
  <data key="d0">Managers</data>
  <data key="d1">organization</data>
  <data key="d2">Managers are professionals whose job is to focus on the schedule and defend schedule and requirements, although most managers want the truth and good code.&lt;SEP&gt;Professional people responsible for focusing on the schedule and relying on developers for realistic commitments and code defense.&lt;SEP&gt;A group of people who ask developers why estimates become large.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002&lt;SEP&gt;doc-e6b59836a05af0c112c0d24b77e2c123-chunk-001</data>
  <data key="d4">chapter-01.txt&lt;SEP&gt;chapter-09.txt</data>
  <data key="d5">1790606382</data>
  <data key="d6"></data>
</node>
<node id="Marketers">
  <data key="d0">Marketers</data>
  <data key="d1">other</data>
  <data key="d2">Marketers are professionals whose job is to focus on features.&lt;SEP&gt;Professional people responsible for focusing on features and looking to developers for information needed to make promises and commitments.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Schedule">
  <data key="d0">Schedule</data>
  <data key="d1">data</data>
  <data key="d2">Schedule is the timing focus that managers defend and that programmers must not compromise by creating messy code.&lt;SEP&gt;A commitment-based timeline provided by developers and focused on by managers, expected to be based on reality.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Features">
  <data key="d0">Features</data>
  <data key="d1">concept</data>
  <data key="d2">Features are the subject of marketers' focus.&lt;SEP&gt;Product characteristics focused on by marketers while making promises and commitments.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Cost of a Mess">
  <data key="d0">Cost of a Mess</data>
  <data key="d1">concept</data>
  <data key="d2">The financial and emotional cost of messy code, including lost revenue, bankruptcy, frustration, fear, and the feeling of code working against developers.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Staff">
  <data key="d0">Staff</data>
  <data key="d1">organization</data>
  <data key="d2">Newly added project personnel not versed in system design, under pressure to increase productivity, and contributing to more mess.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="LeBlanc">
  <data key="d0">LeBlanc</data>
  <data key="d1">person</data>
  <data key="d2">The namesake of LeBlanc's Law, a principle stating that later equals never.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Horatio">
  <data key="d0">Horatio</data>
  <data key="d1">person</data>
  <data key="d2">A person addressed in the passage when fault is assigned to internal behavior rather than external stars.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Design Intent">
  <data key="d0">Design Intent</data>
  <data key="d1">concept</data>
  <data key="d2">The intended design outcome that a change can either match or thwart.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Original Design">
  <data key="d0">Original Design</data>
  <data key="d1">concept</data>
  <data key="d2">The earlier design that changed requirements are said to thwart.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="System Design">
  <data key="d0">System Design</data>
  <data key="d1">concept</data>
  <data key="d2">The design of the system that staff are not versed in.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Green-Field Project">
  <data key="d0">Green-Field Project</data>
  <data key="d1">concept</data>
  <data key="d2">A project type described as allowing work to start from scratch and create something truly beautiful.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-001</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Code-Sense">
  <data key="d0">Code-Sense</data>
  <data key="d1">concept</data>
  <data key="d2">Code-Sense is a painstakingly acquired sense of cleanliness that lets a programmer recognize good or bad code and choose a sequence of behavior preserving transformations.&lt;SEP&gt;An intuitive programming skill that the book cannot promise to give.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-006</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Doctors">
  <data key="d0">Doctors</data>
  <data key="d1">other</data>
  <data key="d2">Doctors are medical professionals who should refuse patient demands to stop hand-washing because doctors know more about the risks of disease and infection.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Patients">
  <data key="d0">Patients</data>
  <data key="d1">other</data>
  <data key="d2">Patients are individuals who are the boss of a doctor but may demand shortcuts such as stopping hand-washing before surgery.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Professional Honor">
  <data key="d0">Professional Honor</data>
  <data key="d1">concept</data>
  <data key="d2">Professional Honor is the ethical commitment that programmers use when defending code and when refusing to lie about code or schedule.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Messy Code">
  <data key="d0">Messy Code</data>
  <data key="d1">concept</data>
  <data key="d2">Messy Code is poor code that slows developers and can cause deadlines to be missed.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="The Primal Conundrum">
  <data key="d0">The Primal Conundrum</data>
  <data key="d1">concept</data>
  <data key="d2">The Primal Conundrum is the conflict in which developers know previous messes slow them down yet feel pressure to make messes to meet deadlines.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Behavior Preserving Transformations">
  <data key="d0">Behavior Preserving Transformations</data>
  <data key="d1">method</data>
  <data key="d2">Behavior Preserving Transformations are changes applied to transform bad code into clean code while preserving behavior.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Bjarne Stroustrup">
  <data key="d0">Bjarne Stroustrup</data>
  <data key="d1">person</data>
  <data key="d2">Bjarne Stroustrup is the inventor of C++ and the author of The C++ Programming Language, and he describes clean code as elegant and efficient.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="The C++ Programming Language">
  <data key="d0">The C++ Programming Language</data>
  <data key="d1">content</data>
  <data key="d2">The C++ Programming Language is a book authored by Bjarne Stroustrup.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Elegant">
  <data key="d0">Elegant</data>
  <data key="d1">concept</data>
  <data key="d2">Elegant is a quality of clean code defined as pleasingly graceful and stylish in appearance or manner, and pleasingly ingenious and simple.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Efficient">
  <data key="d0">Efficient</data>
  <data key="d1">concept</data>
  <data key="d2">Efficient is a quality of clean code mentioned twice by Bjarne Stroustrup and associated with performance close to optimal.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Performance">
  <data key="d0">Performance</data>
  <data key="d1">concept</data>
  <data key="d2">Performance is a close-to-optimal characteristic of clean code that should not tempt unprincipled optimizations.&lt;SEP&gt;A musical performance associated with the concert violinist and Carnegie Hall.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-006</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="One Thing Well">
  <data key="d0">One Thing Well</data>
  <data key="d1">concept</data>
  <data key="d2">One Thing Well is a property of clean code where code performs a single task well.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Ignaz Semmelweis">
  <data key="d0">Ignaz Semmelweis</data>
  <data key="d1">person</data>
  <data key="d2">Ignaz Semmelweis is a physician who first recommended hand-washing to physicians in 1847.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Hand-Washing">
  <data key="d0">Hand-Washing</data>
  <data key="d1">method</data>
  <data key="d2">Hand-Washing is a hygienic practice recommended before patient visits and before surgery to reduce risk.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Surgery">
  <data key="d0">Surgery</data>
  <data key="d1">method</data>
  <data key="d2">Surgery is a medical procedure in which hand-washing preparation is expected to reduce disease and infection risk.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Disease">
  <data key="d0">Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Disease is a risk that hand-washing helps prevent in the doctor-patient analogy.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Infection">
  <data key="d0">Infection</data>
  <data key="d1">concept</data>
  <data key="d2">Infection is a risk that hand-washing helps prevent in the doctor-patient analogy.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Painting A Picture">
  <data key="d0">Painting A Picture</data>
  <data key="d1">concept</data>
  <data key="d2">Painting A Picture is an analogy explaining that recognizing clean code does not imply knowing how to write clean code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Blank Screen">
  <data key="d0">Blank Screen</data>
  <data key="d1">artifact</data>
  <data key="d2">Blank Screen is the starting state that a programmer who writes clean code transforms into an elegantly coded system.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Elegantly Coded System">
  <data key="d0">Elegantly Coded System</data>
  <data key="d1">artifact</data>
  <data key="d2">Elegantly Coded System is the result of applying clean-code transformations from a blank screen.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="MacBook">
  <data key="d0">MacBook</data>
  <data key="d1">artifact</data>
  <data key="d2">MacBook is a device that provides a dictionary used to define elegant.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Dictionary">
  <data key="d0">Dictionary</data>
  <data key="d1">content</data>
  <data key="d2">Dictionary is a reference on the MacBook that defines elegant as pleasingly graceful, stylish, ingenious, and simple.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Maintenance">
  <data key="d0">Maintenance</data>
  <data key="d1">concept</data>
  <data key="d2">Maintenance is eased by minimal dependencies in clean code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Unprincipled Optimizations">
  <data key="d0">Unprincipled Optimizations</data>
  <data key="d1">concept</data>
  <data key="d2">Unprincipled Optimizations are messy changes tempted when code performance is not close to optimal.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Deadlines">
  <data key="d0">Deadlines</data>
  <data key="d1">concept</data>
  <data key="d2">Deadlines are time limits that pressure developers to make messes and that clean code helps meet.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Project">
  <data key="d0">Project</data>
  <data key="d1">artifact</data>
  <data key="d2">Project is the work product being planned, whose failures can result from bad code.&lt;SEP&gt;A class type referenced by SuperDashboard methods for project retrieval, addition, removal, loading, and selection.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-000</data>
  <data key="d4">chapter-01.txt&lt;SEP&gt;chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
</node>
<node id="Responsibility">
  <data key="d0">Responsibility</data>
  <data key="d1">concept</data>
  <data key="d2">Responsibility is the shared accountability for project failures, especially when failures involve bad code.&lt;SEP&gt;The measure used to evaluate class size in place of counting physical lines.&lt;SEP&gt;A Responsibility is a duty fulfilled by a class. A class should have one responsibility, which is the same as having one reason to change, and having too many responsibilities indicates a class is too large.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-000&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-001</data>
  <data key="d4">chapter-01.txt&lt;SEP&gt;chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
</node>
<node id="Failures">
  <data key="d0">Failures</data>
  <data key="d1">event</data>
  <data key="d2">Failures are project failures, especially those related to bad code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Go Fast">
  <data key="d0">Go Fast</data>
  <data key="d1">concept</data>
  <data key="d2">Go Fast is the goal of speed and making deadlines, achieved by keeping code clean.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Writing Clean Code">
  <data key="d0">Writing Clean Code</data>
  <data key="d1">method</data>
  <data key="d2">Writing Clean Code is the disciplined activity of producing clean code using techniques and code-sense.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Techniques">
  <data key="d0">Techniques</data>
  <data key="d1">method</data>
  <data key="d2">Techniques are the many small methods used to write and clean code.&lt;SEP&gt;Practical techniques listed or shown in the book and used by artists or programmers.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-006</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Strategy">
  <data key="d0">Strategy</data>
  <data key="d1">concept</data>
  <data key="d2">Strategy is the plan shown by code-sense for applying discipline to transform bad code into clean code and for complete error handling.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Messy Module">
  <data key="d0">Messy Module</data>
  <data key="d1">artifact</data>
  <data key="d2">Messy Module is a piece of code that a programmer without code-sense can recognize as messy but not know how to fix.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Artist">
  <data key="d0">Artist</data>
  <data key="d1">other</data>
  <data key="d2">Artist is a metaphor for a programmer who transforms a blank screen into an elegantly coded system.&lt;SEP&gt;An artist whose tools, techniques, and thought processes are used as examples by books on art.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-006</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Logic">
  <data key="d0">Logic</data>
  <data key="d1">concept</data>
  <data key="d2">Logic is the reasoning structure of code that should be straightforward so bugs cannot hide.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Pleasing">
  <data key="d0">Pleasing</data>
  <data key="d1">concept</data>
  <data key="d2">Pleasing is the quality emphasized in elegant, making clean code pleasant to read.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Patient Visits">
  <data key="d0">Patient Visits</data>
  <data key="d1">event</data>
  <data key="d2">Patient Visits are encounters between physician and patient, between which hand-washing was recommended.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="1847">
  <data key="d0">1847</data>
  <data key="d1">data</data>
  <data key="d2">1847 is the year hand-washing was first recommended to physicians by Ignaz Semmelweis.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Physicians">
  <data key="d0">Physicians</data>
  <data key="d1">other</data>
  <data key="d2">Physicians are medical practitioners to whom hand-washing was first recommended by Ignaz Semmelweis in 1847.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Bjarne">
  <data key="d0">Bjarne</data>
  <data key="d1">person</data>
  <data key="d2">Bjarne is identified as the inventor of C++ and is presented as a source of views that clean code should be pleasing, efficient, focused, and complete in error handling.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Broken Windows Metaphor">
  <data key="d0">Broken Windows Metaphor</data>
  <data key="d1">concept</data>
  <data key="d2">Broken Windows Metaphor is a metaphor stating that a building with broken windows looks neglected, invites more broken windows, graffiti, garbage, and decay.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Efficiency">
  <data key="d0">Efficiency</data>
  <data key="d1">concept</data>
  <data key="d2">Efficiency is an attribute Bjarne mentions in connection with clean code; wasted cycles are described as inelegant and not pleasing.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Grady Booch">
  <data key="d0">Grady Booch</data>
  <data key="d1">person</data>
  <data key="d2">Grady Booch is the author of Object Oriented Analysis and Design with Applications and describes clean code as simple, direct, readable, and full of crisp abstractions.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Object Oriented Analysis and Design with Applications">
  <data key="d0">Object Oriented Analysis and Design with Applications</data>
  <data key="d1">content</data>
  <data key="d2">Object Oriented Analysis and Design with Applications is a book authored by Grady Booch and is cited as a source of views on clean code.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Lord of the Rings">
  <data key="d0">Lord of the Rings</data>
  <data key="d1">content</data>
  <data key="d2">Lord of the Rings is a literary work used as a comparison for reading clean code; reading clean code will never be quite like reading Lord of the Rings.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="OTI">
  <data key="d0">OTI</data>
  <data key="d1">organization</data>
  <data key="d2">OTI is an organization founded by Dave Thomas.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Unit and Acceptance Tests">
  <data key="d0">Unit and Acceptance Tests</data>
  <data key="d1">method</data>
  <data key="d2">Unit and Acceptance Tests are tests that Dave Thomas says clean code must have.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Crisp Abstraction">
  <data key="d0">Crisp Abstraction</data>
  <data key="d1">concept</data>
  <data key="d2">Crisp Abstraction is a phrase used by Grady Booch to describe clean code; the text calls the phrase a fascinating oxymoron and says code should be matter-of-fact and contain only what is necessary.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Knuth">
  <data key="d0">Knuth</data>
  <data key="d1">person</data>
  <data key="d2">Knuth is referenced in the text in connection with Dave Thomas's point that code should be literate.&lt;SEP&gt;A person referenced as the source of literate programming and cited as Knuth92.&lt;SEP&gt;The author associated with the book Literate Programming, the PrintPrimes program, and the WEB Tool.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-002</data>
  <data key="d4">chapter-01.txt&lt;SEP&gt;chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
</node>
<node id="Literate Code">
  <data key="d0">Literate Code</data>
  <data key="d1">concept</data>
  <data key="d2">Literate Code is the quality of being literate that Dave Thomas says clean code should have, and the text links this point to Knuth.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Minimal Dependencies">
  <data key="d0">Minimal Dependencies</data>
  <data key="d1">concept</data>
  <data key="d2">Minimal Dependencies are explicitly defined dependencies that Dave Thomas says clean code has, reflecting a preference for small and clear structure.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Minimal API">
  <data key="d0">Minimal API</data>
  <data key="d1">concept</data>
  <data key="d2">Minimal API is a clear and minimal interface that Dave Thomas says clean code provides.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Eclipse Strategy">
  <data key="d0">Eclipse Strategy</data>
  <data key="d1">concept</data>
  <data key="d2">Eclipse Strategy is a strategy with which Dave Thomas is described as a godfather in the text.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-003</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Minimal Code">
  <data key="d0">Minimal Code</data>
  <data key="d1">concept</data>
  <data key="d2">Small code that is preferred over large code and is emphasized by Dave.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Literate Programming">
  <data key="d0">Literate Programming</data>
  <data key="d1">content</data>
  <data key="d2">A programming approach associated with Knuth in which code is composed to be readable by humans.&lt;SEP&gt;A 1992 work by Donald E. Knuth listed with the Center for the Study of Language and Information and Leland Stanford Junior University.&lt;SEP&gt;A book by Knuth that provides a source for the PrintPrimes example used to illustrate splitting functions and classes.&lt;SEP&gt;Literate Programming is a 1992 book cited in the bibliography.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-006&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-002&lt;SEP&gt;doc-4482a25ecfcd0fad59918839a6f47f2a-chunk-006</data>
  <data key="d4">chapter-01.txt&lt;SEP&gt;chapter-10.txt</data>
  <data key="d5">1790606393</data>
  <data key="d6"></data>
</node>
<node id="Dave">
  <data key="d0">Dave</data>
  <data key="d1">person</data>
  <data key="d2">A person who emphasizes minimal code and says code should be literate.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Michael Feathers">
  <data key="d0">Michael Feathers</data>
  <data key="d1">person</data>
  <data key="d2">The author of Working Effectively with Legacy Code, who describes clean code as looking written by someone who cares.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Extreme Programming Installed">
  <data key="d0">Extreme Programming Installed</data>
  <data key="d1">content</data>
  <data key="d2">A book authored by Ron Jeffries.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Extreme Programming Adventures in C#">
  <data key="d0">Extreme Programming Adventures in C#</data>
  <data key="d1">content</data>
  <data key="d2">A book authored by Ron Jeffries.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Strategic Air Command">
  <data key="d0">Strategic Air Command</data>
  <data key="d1">organization</data>
  <data key="d2">An organization where Ron Jeffries began a career programming in Fortran.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Beck">
  <data key="d0">Beck</data>
  <data key="d1">person</data>
  <data key="d2">A person whose rules of simple code are cited by Ron Jeffries.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Rules of Simple Code">
  <data key="d0">Rules of Simple Code</data>
  <data key="d1">concept</data>
  <data key="d2">A priority-ordered set of criteria stating that simple code runs all tests, contains no duplication, expresses design ideas, and minimizes entities.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Simple Code">
  <data key="d0">Simple Code</data>
  <data key="d1">concept</data>
  <data key="d2">Code that satisfies the rules of simple code, including running tests, avoiding duplication, expressing design ideas, and minimizing entities.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Expressiveness">
  <data key="d0">Expressiveness</data>
  <data key="d1">concept</data>
  <data key="d2">A code quality involving meaningful names and single-purpose objects or methods, improved through renaming and refactoring.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Extract Method Refactoring">
  <data key="d0">Extract Method Refactoring</data>
  <data key="d1">method</data>
  <data key="d2">A refactoring technique used on a method doing more than one thing to produce a clearer method and submethods.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
  <data key="d4">chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
<node id="Hash Map">
  <data key="d0">Hash Map</data>
  <data key="d1">concept</data>
  <data key="d2">A simple data structure used as an implementation for a collection abstraction.</data>
  <data key="d3">doc-d58f62a4832abf3c8bbf730215895c6d-chunk-004</data>
