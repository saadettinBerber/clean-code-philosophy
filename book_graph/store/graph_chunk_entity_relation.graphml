<node id="Context Switch">
  <data key="d0">Context Switch</data>
  <data key="d1">concept</data>
  <data key="d2">A transition that chooses between T threads before each execution step when calculating possible execution orderings.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-001</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790598945</data>
  <data key="d6"></data>
</node>
<node id="Path Representation String">
  <data key="d0">Path Representation String</data>
  <data key="d1">concept</data>
  <data key="d2">A string of digits that represents a possible execution path by encoding the sequence of context switches.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-001</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790598945</data>
  <data key="d6"></data>
</node>
<node id="Possible Path Count Formula">
  <data key="d0">Possible Path Count Formula</data>
  <data key="d1">concept</data>
  <data key="d2">A formula for the total number of possible execution paths for N instructions executed by T threads, expressed from the interleaving of N instructions and T threads.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-001</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790598945</data>
  <data key="d6"></data>
</node>
<node id="Execution Step">
  <data key="d0">Execution Step</data>
  <data key="d1">concept</data>
  <data key="d2">A step in an execution sequence, represented by a bytecode instruction, over which T threads can interleave and be selected by context switches.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-001</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790598945</data>
