  <data key="d0">Brian W. Kernighan</data>
  <data key="d1">person</data>
  <data key="d2">Person attributed, together with P. J. Plaugher, to the quoted principle about not commenting bad code.</data>
  <data key="d3">doc-ecee1e439eb5fb52d346911e1683e490-chunk-000</data>
  <data key="d4">chapter-04.txt</data>
  <data key="d5">1790604159</data>
  <data key="d6"></data>
