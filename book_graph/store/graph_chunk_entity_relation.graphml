<node id="Conceptual Affinity">
  <data key="d0">Conceptual Affinity</data>
  <data key="d1">concept</data>
  <data key="d2">Conceptual Affinity is a principle that code elements with close conceptual relationships should be placed near one another, with stronger affinity reducing vertical distance.</data>
  <data key="d3">doc-ae06dfc90c814559f684ae92cc598260-chunk-003</data>
  <data key="d4">chapter-05.txt</data>
  <data key="d5">1790604436</data>
  <data key="d6"></data>
</node>
<node id="Vertical Ordering">
  <data key="d0">Vertical Ordering</data>
  <data key="d1">concept</data>
  <data key="d2">Vertical Ordering is a code-layout principle that places called functions below calling functions so source files flow from high-level concepts to low-level details.</data>
  <data key="d3">doc-ae06dfc90c814559f684ae92cc598260-chunk-003</data>
  <data key="d4">chapter-05.txt</data>
  <data key="d5">1790604436</data>
  <data key="d6"></data>
</node>
