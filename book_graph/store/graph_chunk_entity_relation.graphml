</node>
<node id="Target Weekday">
  <data key="d0">Target Weekday</data>
  <data key="d1">concept</data>
  <data key="d2">Target Weekday is a parameter representing the desired day-of-the-week code used by SerialDate methods to locate a previous, following, or nearest weekday date.</data>
  <data key="d3">doc-b96a37e68a1f0fd9f9aae3b5629b124f-chunk-017</data>
  <data key="d4">chapter-18.txt</data>
  <data key="d5">1790599048</data>
