<node id="Discipline">
  <data key="d0">Discipline</data>
  <data key="d1">concept</data>
  <data key="d2">Discipline is the professional practice produced by values, alongside craftsmanship, according to the conclusion.&lt;SEP&gt;Discipline is the self-control applied in writing clean code and transforming bad code into clean code.</data>
  <data key="d3">doc-0af28655754ee82c5f5f3411cf8f5c39-chunk-012&lt;SEP&gt;doc-d58f62a4832abf3c8bbf730215895c6d-chunk-002</data>
  <data key="d4">chapter-17.txt&lt;SEP&gt;chapter-01.txt</data>
  <data key="d5">1790606209</data>
  <data key="d6"></data>
</node>
