  <data key="d0">Nested Loops</data>
  <data key="d1">concept</data>
  <data key="d2">Loops nested inside other loops that appear in initial long and complicated functions.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Indenting">
  <data key="d0">Indenting</data>
  <data key="d1">concept</data>
  <data key="d2">Indentation present in initial long and complicated functions.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Long Argument Lists">
  <data key="d0">Long Argument Lists</data>
  <data key="d1">concept</data>
  <data key="d2">Long argument lists present in initial clumsy functions.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
  <data key="d6"></data>
</node>
<node id="Arbitrary Names">
  <data key="d0">Arbitrary Names</data>
  <data key="d1">concept</data>
  <data key="d2">Arbitrary names used in initial code before code refinement changes names.</data>
  <data key="d3">doc-70106d3c6c60a2a04b530f45336de970-chunk-008</data>
  <data key="d4">chapter-03.txt</data>
  <data key="d5">1790603783</data>
