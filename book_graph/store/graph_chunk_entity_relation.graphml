  <data key="d2">Cross-cutting concern mentioned in the required application infrastructure list.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
<node id="XmlBeanFactory">
  <data key="d0">XmlBeanFactory</data>
  <data key="d1">artifact</data>
  <data key="d2">Spring class used to create a bean factory from a ClassPathResource referencing app.xml and to retrieve beans by name.</data>
  <data key="d3">doc-f8b0f36a5c42d0808fec00a058082be8-chunk-004</data>
  <data key="d4">chapter-11.txt</data>
  <data key="d5">1790605586</data>
  <data key="d6"></data>
</node>
